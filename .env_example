# Banco de dados (PostgreSQL / Neon)
# Ex.: postgresql://usuario:senha@host:5432/desafio-valentes?schema=public
DATABASE_URL="postgresql://usuario:senha@172.18.0.1:5432/desafio-valentes?schema=public"
DIRECT_URL="postgresql://usuario:senha@172.18.0.1:5432/desafio-valentes?schema=public"

# Auth.js
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-secret-aleatorio"
AUTH_TRUST_HOST="true"

# Super Admin (criado pelo seed)
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="super123"
SUPER_ADMIN_PHONE="11999999999"

# Vercel Blob (opcional)
# Em producao (Vercel), defina para permitir upload proprio de midia.
# Em desenvolvimento, se vazio, os uploads vao para public/uploads.
BLOB_READ_WRITE_TOKEN=""
